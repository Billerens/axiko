{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.org/axiko-marketplace/schema/v1/index.schema.json",
  "title": "Axiko catalog head v1",
  "description": "index.json: the repository and the pages that hold its packages. Example schema namespace is a placeholder. 1 MiB UTF-8 limit; client hard limits cannot be raised by repository metadata.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "repository",
    "packageCount",
    "pages"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "repository": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "title",
        "homepage"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 96,
          "pattern": "^[a-z0-9][a-z0-9.-]*$"
        },
        "title": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120
        },
        "homepage": {
          "type": "string",
          "minLength": 9,
          "maxLength": 2048,
          "pattern": "^https://",
          "format": "uri",
          "description": "HTTPS URL without credentials or a fragment. Additional semantic validation applies."
        },
        "description": {
          "type": "string",
          "minLength": 1,
          "maxLength": 600
        }
      }
    },
    "packageCount": {
      "type": "integer",
      "minimum": 0,
      "maximum": 20000
    },
    "pages": {
      "type": "array",
      "maxItems": 256,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "path",
          "sha256",
          "size",
          "count"
        ],
        "properties": {
          "path": {
            "type": "string",
            "minLength": 1,
            "maxLength": 240,
            "description": "Relative to the folder of index.json, forward slashes, no parent or hidden components. Additional semantic validation applies.",
            "pattern": "\\.json$"
          },
          "sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "size": {
            "type": "integer",
            "minimum": 2,
            "maximum": 1048576
          },
          "count": {
            "type": "integer",
            "minimum": 1,
            "maximum": 2000
          }
        }
      }
    }
  }
}
