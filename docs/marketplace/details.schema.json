{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.org/axiko-marketplace/schema/v1/details.schema.json",
  "title": "Axiko package details v1",
  "description": "What is read when a package is opened. 256 KiB UTF-8 limit. Texts are untrusted Markdown; pictures are fetched by path, size and hash.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "id",
    "version"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 96,
      "pattern": "^[a-z0-9][a-z0-9.-]*$"
    },
    "version": {
      "type": "string",
      "maxLength": 96,
      "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(?:-(?:(?:0|[1-9][0-9]*|[0-9]*[A-Za-z-][0-9A-Za-z-]*)(?:\\.(?:0|[1-9][0-9]*|[0-9]*[A-Za-z-][0-9A-Za-z-]*))*))?(?:\\+(?:[0-9A-Za-z-]+(?:\\.[0-9A-Za-z-]+)*))?$"
    },
    "description": {
      "type": "string",
      "minLength": 1,
      "maxLength": 20000
    },
    "screenshots": {
      "type": "array",
      "maxItems": 8,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "path",
          "sha256",
          "size",
          "type",
          "width",
          "height"
        ],
        "properties": {
          "path": {
            "type": "string",
            "minLength": 1,
            "maxLength": 240,
            "description": "Relative to the folder of index.json, forward slashes, no parent or hidden components. Additional semantic validation applies."
          },
          "sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "size": {
            "type": "integer",
            "minimum": 1,
            "maximum": 1048576
          },
          "type": {
            "enum": [
              "image/png",
              "image/webp",
              "image/jpeg"
            ]
          },
          "width": {
            "type": "integer",
            "minimum": 1,
            "maximum": 10000
          },
          "height": {
            "type": "integer",
            "minimum": 1,
            "maximum": 10000
          },
          "caption": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200
          }
        }
      }
    },
    "changes": {
      "type": "array",
      "maxItems": 20,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "version",
          "notes"
        ],
        "properties": {
          "version": {
            "type": "string",
            "maxLength": 96,
            "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(?:-(?:(?:0|[1-9][0-9]*|[0-9]*[A-Za-z-][0-9A-Za-z-]*)(?:\\.(?:0|[1-9][0-9]*|[0-9]*[A-Za-z-][0-9A-Za-z-]*))*))?(?:\\+(?:[0-9A-Za-z-]+(?:\\.[0-9A-Za-z-]+)*))?$"
          },
          "date": {
            "type": "string",
            "pattern": "^[0-9]{4}-(0[1-9]|1[0-2])-(0[1-9]|[12][0-9]|3[01])$"
          },
          "notes": {
            "type": "string",
            "minLength": 1,
            "maxLength": 4000
          }
        }
      }
    },
    "locales": {
      "type": "object",
      "maxProperties": 16,
      "propertyNames": {
        "pattern": "^[a-z]{2,3}(-[A-Za-z]{2,4})?$"
      },
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "minProperties": 1,
        "properties": {
          "description": {
            "type": "string",
            "minLength": 1,
            "maxLength": 20000
          },
          "changes": {
            "type": "object",
            "maxProperties": 20,
            "propertyNames": {
              "maxLength": 96,
              "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(?:-(?:(?:0|[1-9][0-9]*|[0-9]*[A-Za-z-][0-9A-Za-z-]*)(?:\\.(?:0|[1-9][0-9]*|[0-9]*[A-Za-z-][0-9A-Za-z-]*))*))?(?:\\+(?:[0-9A-Za-z-]+(?:\\.[0-9A-Za-z-]+)*))?$"
            },
            "additionalProperties": {
              "type": "string",
              "minLength": 1,
              "maxLength": 4000
            },
            "description": "The notes of a version of `changes`, by version; a version that is not here is in English."
          },
          "captions": {
            "type": "array",
            "maxItems": 8,
            "items": {
              "type": [
                "string",
                "null"
              ],
              "minLength": 1,
              "maxLength": 200
            },
            "description": "Captions of the screenshots in the same order; null leaves a caption in English."
          }
        }
      },
      "description": "The texts in other languages by language code. A language gives only what it translates; the rest is English. English itself is not listed. Additional semantic validation applies."
    },
    "links": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "homepage": {
          "type": "string",
          "minLength": 9,
          "maxLength": 2048,
          "pattern": "^https://",
          "format": "uri",
          "description": "HTTPS URL without credentials or a fragment. Additional semantic validation applies."
        },
        "source": {
          "type": "string",
          "minLength": 9,
          "maxLength": 2048,
          "pattern": "^https://",
          "format": "uri",
          "description": "HTTPS URL without credentials or a fragment. Additional semantic validation applies."
        },
        "support": {
          "type": "string",
          "minLength": 9,
          "maxLength": 2048,
          "pattern": "^https://",
          "format": "uri",
          "description": "HTTPS URL without credentials or a fragment. Additional semantic validation applies."
        }
      }
    }
  }
}
