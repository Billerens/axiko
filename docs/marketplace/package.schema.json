{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.org/assi-marketplace/schema/v1/package.schema.json",
  "title": "Axiko readable package manifest v1",
  "description": "Manifest metadata only; validity does not establish archive integrity, readable code, enforced permissions or safety. package.json is excluded from files; archive total including it must be at most 512 files.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "id",
    "kind",
    "version",
    "publisher",
    "license",
    "sourceFormat",
    "runtime",
    "dependencies",
    "optionalDependencies",
    "capabilities",
    "files"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 96,
      "pattern": "^[a-z0-9][a-z0-9.-]*$"
    },
    "kind": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]{0,31}$",
      "description": "`module`, or a kind that some module hosts and declares in its module.json; the schema keeps no list of kinds."
    },
    "version": {
      "type": "string",
      "maxLength": 96,
      "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(?:-(?:(?:0|[1-9][0-9]*|[0-9]*[A-Za-z-][0-9A-Za-z-]*)(?:\\.(?:0|[1-9][0-9]*|[0-9]*[A-Za-z-][0-9A-Za-z-]*))*))?(?:\\+(?:[0-9A-Za-z-]+(?:\\.[0-9A-Za-z-]+)*))?$"
    },
    "publisher": {
      "type": "string",
      "minLength": 1,
      "maxLength": 96,
      "pattern": "^[a-z0-9][a-z0-9.-]*$",
      "description": "Stable publisher identity, not a trust or signature verdict."
    },
    "license": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "description": "Declared license identifier or SPDX expression; this validator does not verify license terms."
    },
    "sourceFormat": {
      "const": "readable"
    },
    "entry": {
      "type": "string",
      "minLength": 1,
      "maxLength": 240,
      "pattern": "^code/[^\\\\]+$",
      "description": "Executable entry within code/, also present exactly once in files. It is metadata only; this validator never executes it."
    },
    "runtime": {
      "type": "object",
      "required": [
        "assiApi"
      ],
      "maxProperties": 2,
      "propertyNames": {
        "pattern": "^[a-z][A-Za-z0-9]{0,31}$"
      },
      "properties": {
        "assiApi": {
          "type": "integer",
          "minimum": 1
        }
      },
      "additionalProperties": {
        "type": "integer",
        "minimum": 1
      },
      "description": "Besides assiApi, the version of its host's rules under the name the host declares, e.g. gamesEngine for games."
    },
    "dependencies": {
      "type": "array",
      "maxItems": 64,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "version"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 96,
            "pattern": "^[a-z0-9][a-z0-9.-]*$"
          },
          "version": {
            "type": "string",
            "maxLength": 98,
            "pattern": "^(?:>=)?(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(?:-(?:(?:0|[1-9][0-9]*|[0-9]*[A-Za-z-][0-9A-Za-z-]*)(?:\\.(?:0|[1-9][0-9]*|[0-9]*[A-Za-z-][0-9A-Za-z-]*))*))?(?:\\+(?:[0-9A-Za-z-]+(?:\\.[0-9A-Za-z-]+)*))?$",
            "description": "v1 accepts one exact SemVer or >=SemVer. Resolution is a future client responsibility."
          }
        }
      }
    },
    "optionalDependencies": {
      "type": "array",
      "maxItems": 64,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "version"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 96,
            "pattern": "^[a-z0-9][a-z0-9.-]*$"
          },
          "version": {
            "type": "string",
            "maxLength": 98,
            "pattern": "^(?:>=)?(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(?:-(?:(?:0|[1-9][0-9]*|[0-9]*[A-Za-z-][0-9A-Za-z-]*)(?:\\.(?:0|[1-9][0-9]*|[0-9]*[A-Za-z-][0-9A-Za-z-]*))*))?(?:\\+(?:[0-9A-Za-z-]+(?:\\.[0-9A-Za-z-]+)*))?$",
            "description": "v1 accepts one exact SemVer or >=SemVer. Resolution is a future client responsibility."
          }
        }
      }
    },
    "capabilities": {
      "type": "array",
      "maxItems": 64,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 96,
        "pattern": "^[a-z][a-z0-9]*(?:\\.[a-z][a-z0-9-]*)+$"
      },
      "description": "Informational declarations only. The current runtime does not enforce these as a sandbox."
    },
    "networkDomains": {
      "type": "array",
      "maxItems": 32,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 253,
        "pattern": "^(?:[a-z0-9](?:[a-z0-9-]{0,61}[a-z0-9])?\\.)*[a-z0-9](?:[a-z0-9-]{0,61}[a-z0-9])?$"
      }
    },
    "files": {
      "type": "array",
      "minItems": 3,
      "maxItems": 511,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "path",
          "sha256",
          "size"
        ],
        "properties": {
          "path": {
            "type": "string",
            "minLength": 1,
            "maxLength": 240,
            "pattern": "^(?:README\\.md|LICENSE|(?:code|assets|mod|reference|base)/[^\\\\]+)$",
            "description": "Canonical NFC relative path. A package holds code/ and assets/; a mod holds mod/, reference/, base/ and assets/; both hold README.md and LICENSE. No empty/dot/hidden segments, backslashes, absolute paths or Windows-unsafe names."
          },
          "sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "size": {
            "type": "integer",
            "minimum": 0,
            "maximum": 2097152
          }
        }
      }
    },
    "extends": {
      "type": "string",
      "minLength": 1,
      "maxLength": 96,
      "pattern": "^[a-z0-9][a-z0-9.-]*$",
      "description": "For a mod: the package it changes."
    },
    "reference": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "version",
        "base",
        "added",
        "removed"
      ],
      "description": "For a mod: what its sample was made on. Information for whoever carries the mod over, never a requirement.",
      "properties": {
        "version": {
          "type": "string",
          "maxLength": 96,
          "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(?:-(?:(?:0|[1-9][0-9]*|[0-9]*[A-Za-z-][0-9A-Za-z-]*)(?:\\.(?:0|[1-9][0-9]*|[0-9]*[A-Za-z-][0-9A-Za-z-]*))*))?(?:\\+(?:[0-9A-Za-z-]+(?:\\.[0-9A-Za-z-]+)*))?$"
        },
        "archiveSha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "base": {
          "type": "object",
          "maxProperties": 511,
          "additionalProperties": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "description": "Files of the target the mod changed or removed, by path in the target, with the hash of each as it was before."
        },
        "added": {
          "type": "array",
          "maxItems": 511,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 240
          }
        },
        "removed": {
          "type": "array",
          "maxItems": 511,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 240
          }
        }
      }
    }
  },
  "allOf": [
    {
      "properties": {
        "files": {
          "contains": {
            "properties": {
              "path": {
                "const": "README.md"
              }
            },
            "required": [
              "path"
            ]
          }
        }
      }
    },
    {
      "properties": {
        "files": {
          "contains": {
            "properties": {
              "path": {
                "const": "LICENSE"
              }
            },
            "required": [
              "path"
            ]
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "kind": {
            "const": "mod"
          }
        }
      },
      "then": {
        "required": [
          "extends",
          "reference"
        ],
        "not": {
          "required": [
            "entry"
          ]
        }
      },
      "else": {
        "required": [
          "entry"
        ],
        "not": {
          "anyOf": [
            {
              "required": [
                "extends"
              ]
            },
            {
              "required": [
                "reference"
              ]
            }
          ]
        }
      }
    }
  ]
}
